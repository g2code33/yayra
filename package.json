{
  "name": "yayra",
  "productName": "yayra",
  "version": "1.0.42",
  "description": "Yayra cross-platform floating browser for Android, Windows, and Linux.",
  "type": "module",
  "main": "electron/main.cjs",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "start": "node scripts/dev-server.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "node scripts/branding.mjs --write && node --test tests/*.test.mjs",
    "prebuild:web": "npm run refresh:branding && npm run verify:versions",
    "build:web": "node scripts/build-web.mjs",
    "build": "npm run build:web",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "deploy:cloudflare:worker": "node scripts/deploy-cloudflare-worker.mjs",
    "link:cloudflare": "bash scripts/link-cloudflare.sh",
    "setup:cloudflare": "bash scripts/setup-cloudflare.sh",
    "refresh:branding": "node scripts/branding.mjs --write",
    "verify:branding": "node scripts/branding.mjs --check",
    "verify:pwa": "node scripts/verify-pwa.mjs",
    "verify:packaging": "node scripts/verify-packaging.mjs",
    "verify:updates": "node --test tests/update-service.test.mjs tests/admin-updates.test.mjs",
    "package:linux:dir": "electron-builder --linux dir --publish never",
    "package:linux:deb": "node scripts/package-linux-deb.mjs",
    "package:linux": "electron-builder --linux deb AppImage --publish never",
    "package:win": "electron-builder --win nsis portable --publish never",
    "package:windows": "node scripts/package-windows.mjs",
    "package:android": "node scripts/package-android.mjs",
    "package:all": "npm run package:android && npm run package:windows && npm run package:linux:deb",
    "build:desktop:linux": "npm run build:web && npm run package:linux",
    "build:desktop:win": "npm run build:web && npm run package:win",
    "build:android": "node scripts/ensure-capacitor-platform.mjs android && npx cap sync android && node scripts/configure-android-signing.mjs && cd android && ./gradlew assembleRelease",
    "build:ios": "node scripts/ensure-capacitor-platform.mjs ios && npx cap sync ios && xcodebuild -workspace ios/App/App.xcworkspace -scheme App -configuration Release -destination generic/platform=iOS -archivePath build/yayra.xcarchive archive && xcodebuild -exportArchive -archivePath build/yayra.xcarchive -exportPath build/ios-export -exportOptionsPlist ios/exportOptions.plist",
    "smoke:desktop": "node scripts/smoke-desktop.mjs",
    "ci:gates": "npm run typecheck && npm run lint && npm test && npm run build:web && npm run verify:pwa && npm run verify:packaging && npm run verify:updates && npm run verify:branding && npm run smoke:desktop",
    "ci:clean-vm": "node scripts/clean-vm-check.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "version:check": "node scripts/version.mjs --check",
    "version:bump": "node scripts/version.mjs",
    "verify:versions": "node scripts/version.mjs --check",
    "test:no-network": "node --import ./tests/no-network-guard.mjs --test tests/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "8.5.2",
    "pdfjs-dist": "^4.10.38",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "typescript": "5.6.3"
  },
  "build": {
    "appId": "com.yayra.app",
    "productName": "yayra",
    "executableName": "yayra",
    "artifactName": "${productName}-${os}-${arch}-${version}.${ext}",
    "asar": true,
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "npmRebuild": false,
    "toolsets": {
      "appimage": "1.0.3"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "yayra",
      "uninstallDisplayName": "yayra",
      "installerIcon": "build/icons/installer.ico",
      "uninstallerIcon": "build/icons/uninstaller.ico",
      "artifactName": "yayra-setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Network",
      "executableName": "yayra",
      "icon": "build/icons/linux-set",
      "syncDesktopName": true
    },
    "deb": {
      "artifactName": "yayra_${version}_amd64.deb",
      "afterInstall": "build/linux/after-install.sh",
      "fpm": [
        "build/linux/usr-bin/yayra=/usr/bin/yayra"
      ]
    },
    "appImage": {
      "artifactName": "yayra-${version}.${ext}"
    },
    "electronVersion": "44.5.1",
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF document",
        "description": "PDF document"
      }
    ]
  },
  "author": {
    "name": "g2code33",
    "email": "support@yayra.app"
  },
  "desktopName": "yayra",
  "overrides": {
    "tar": "^7.5.21",
    "http-cache-semantics": "^4.3.0",
    "uuid": "^11.1.1"
  }
}
